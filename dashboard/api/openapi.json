        },
        "security": [
          {
            "csrfToken": [],
            "staffSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountList": {
        "type": "object",
        "required": [
          "accounts"
        ],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSummary"
            }
          }
        }
      },
      "AccountSummary": {
        "type": "object",
        "description": "A projection of existing account state: no keys, password hashes, device tokens or invented dates/presence.",
        "required": [
          "user_id",
          "role",
          "bp",
          "players"
        ],
        "properties": {
          "bp": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          },
          "login": {
            "type": [
              "string",
              "null"
            ]
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerSummary"
            }
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "unauthenticated",
          "forbidden",
          "invalid_origin",
          "csrf_invalid",
          "rate_limited",
          "not_found",
          "request_conflict",
          "persistence_failed",
          "method_not_allowed",
          "payload_too_large",
          "unsupported_media_type",
          "internal_error"
        ]
      },
      "GiveBpByIdRequest": {
        "type": "object",
        "description": "The dashboard always targets the stable account number, never a renameable player or login label.",
        "required": [
          "user_id",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 1
          },
          "user_id": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "GiveBpResult": {
        "type": "object",
        "required": [
          "user_id",
          "bp",
          "message",
          "request_id"
        ],
        "properties": {
          "bp": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "user_id": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          }
        }
      },
      "PlayerSummary": {
        "type": "object",
        "required": [
          "player_id",
          "name",
          "slot"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "player_id": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          },
          "slot": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "player",
          "moderator",
          "admin"
        ]
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "user",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "user": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "SignedOut": {
        "type": "object",
        "required": [
          "signed_out"
        ],
        "properties": {
          "signed_out": {
            "type": "boolean"
          }
        }
      },
      "StaffSession": {
        "type": "object",
        "required": [
          "user_id",
          "user",
          "role",
          "csrf_token",
          "expires_at"
        ],
        "properties": {
          "csrf_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Idle expiry, refreshed by an authenticated request; capped by the absolute session lifetime."
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "type": "string"
          },
          "user_id": {
            "type": "integer",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      },
      "staffSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "yo3_panel"
      }
    }
  }
}
