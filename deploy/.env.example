# Copy to the repository root as .env. Absolute paths; no quotes needed unless they contain spaces.
YO3_DOMAIN=play.example.com
YO3_GAME_DIR=/srv/yo3/game
YO3_TLS_DIR=/srv/yo3/tls
YO3_ACME_DIR=/srv/yo3/acme
# Default public ports: 7443 game, 80 ACME/redirect, 443 dashboard.
# Optional local-only check: both bindings 127.0.0.1, domain localhost, unused high ports.
# YO3_GAME_BIND=127.0.0.1
# YO3_WEB_BIND=127.0.0.1
# YO3_GAME_PORT=17443
# YO3_HTTP_PORT=18088
# YO3_HTTPS_PORT=18443
YO3_IMAGE_TAG=local
# Set these to the checked-out release and git rev-parse --short=12 HEAD before building.
YO3_BUILD_VERSION=dev
YO3_BUILD_COMMIT=unknown
