# syntax=docker/dockerfile:1.7
FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git g++ pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY engine engine
RUN engine/fetch.sh
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY tools/engine-files.sh tools/engine-files.sh
ARG YO3_BUILD_VERSION=dev
ARG YO3_BUILD_COMMIT=unknown
ENV YO3_BUILD_VERSION=$YO3_BUILD_VERSION YO3_BUILD_COMMIT=$YO3_BUILD_COMMIT CARGO_BUILD_JOBS=2
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git --mount=type=cache,target=/src/target \
    cargo build --locked --release -p yo3-server -p yo3-engine && \
    mkdir -p /out && cp target/release/yo3-server target/release/yo3-engine /out/ && tools/engine-files.sh /out
COPY LICENSE /out/LICENSE

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 && rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 yo3 && useradd --uid 10001 --gid 10001 --no-create-home yo3 && \
    install -d -o yo3 -g yo3 -m 0700 /var/lib/yo3 && install -d -o yo3 -g yo3 -m 0750 /run/yo3-dashboard
WORKDIR /opt/yo3
COPY --from=build /out/ ./
COPY deploy/server.toml /etc/yo3/server.toml
COPY --chmod=755 deploy/server-entrypoint.sh /usr/local/bin/yo3-entrypoint
USER 10001:10001
ENV YO3_ENGINE=/opt/yo3/yo3-engine
EXPOSE 7443
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["curl", "--fail", "--silent", "http://127.0.0.1:8080/health"]
ENTRYPOINT ["/usr/local/bin/yo3-entrypoint"]
