# Where the monitor's alerts go (#37). Copy to /etc/yo3/alerts.env (mode 600). With neither set, alerts only go to the
# journal: journalctl -u yo3-monitor.
# A Discord channel's webhook (Server Settings -> Integrations -> Webhooks -> Copy Webhook URL):
YO3_ALERT_WEBHOOK=
# Or any command that takes the message as its last argument (mail, ntfy, another chat's webhook script); a path
# without spaces, optionally with its own arguments:
YO3_ALERT_COMMAND=
# Limits (the defaults shown):
#YO3_BACKUP_MAX_AGE=7200
#YO3_OFFSITE_MAX_AGE=93600
#YO3_DISK_MAX_PERCENT=90
#YO3_ERRORS_MAX=5
#YO3_HEALTH_URL=http://127.0.0.1:8080/health
#YO3_DATA_DIR=/var/lib/yo3
