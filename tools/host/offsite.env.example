# The off-machine backup's destination (#37). Copy to /etc/yo3/offsite.env (mode 600).
# YO3_OFFSITE: restic (encrypted, keeps 14 daily and 8 weekly copies) or rclone (plain copies, kept YO3_RCLONE_KEEP_DAYS).
YO3_OFFSITE=restic

# restic: a repository and its password, plus the storage's own credentials. Run once to create the repository:
#   sudo systemd-run --pty -p User=yo3 -p EnvironmentFile=/etc/yo3/offsite.env /opt/yo3-revival/systemd/yo3-offsite-backup.sh init
# Keep the password somewhere else too: without it the copies can't be read.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# For S3-compatible object storage, for example:
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# rclone: a remote and folder (rclone config's name), its configuration file, and how long copies are kept.
#YO3_RCLONE_REMOTE=remote:yo3-backups
#RCLONE_CONFIG=/etc/yo3/rclone.conf
#YO3_RCLONE_KEEP_DAYS=30
